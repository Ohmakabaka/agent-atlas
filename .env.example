DATABASE_URL="file:./dev.db"
# Local editor access: choose at least 12 characters. No default password.
ADMIN_PASSWORD=""
# Generate with: openssl rand -hex 32
SESSION_SECRET=""
# Optional OpenAI-compatible service; never required for basic workflows.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Local HTTP production smoke tests only; keep false behind public HTTPS.
ALLOW_INSECURE_ADMIN_COOKIE="false"
# Public site URL for canonical links, sitemap and feed (HTTPS in production).
SITE_URL=""
# Only enable behind a reverse proxy which overwrites this single-IP header.
TRUST_PROXY="false"
TRUSTED_CLIENT_IP_HEADER="x-real-ip"
# Explicit trusted public hosts allowed to resolve through inherited HTTP(S)_PROXY.
# The proxy must enforce public-only destinations; TLS verification stays enabled.
INGESTION_PROXY_HOSTS="github.com,raw.githubusercontent.com"
